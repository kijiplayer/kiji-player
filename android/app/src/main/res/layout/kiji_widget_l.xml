<?xml version="1.0" encoding="utf-8"?>
<!-- Widget grande (4x4): la portada grande, la canción, la línea de la letra que suena (si hay letra
     sincronizada guardada en el teléfono), la onda y los controles. Las imágenes las dibuja
     KijiWidgets.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kiji_widget_bg"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/kiji_widget_cover"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_lyric"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="13sp"
            android:textStyle="italic"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_tomato"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/kiji_widget_tomato"
                android:gravity="center"
                android:text="🍅"
                android:textSize="22sp" />

            <ImageView
                android:id="@+id/widget_prev"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/kiji_widget_prev"
                android:padding="11dp"
                android:src="@drawable/kiji_widget_prev" />

            <ImageView
                android:id="@+id/widget_play"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/kiji_widget_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/kiji_widget_next"
                android:padding="11dp"
                android:src="@drawable/kiji_widget_next" />

            <ImageView
                android:id="@+id/widget_like"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:contentDescription="@string/kiji_widget_like"
                android:padding="12dp"
                android:src="@drawable/kiji_widget_heart" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
