<?xml version="1.0" encoding="utf-8"?>
<!-- Widget chico: anterior, play/pausa y siguiente. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/widget_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="fitXY" android:src="@drawable/kiji_widget_bg" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:orientation="horizontal" android:padding="6dp">
        <ImageView android:id="@+id/widget_prev" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:padding="12dp" android:src="@drawable/kiji_widget_prev" android:contentDescription="@string/kiji_widget_prev" />
        <ImageView android:id="@+id/widget_play" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:padding="10dp" android:src="@drawable/kiji_widget_play" android:contentDescription="@string/kiji_widget_play" />
        <ImageView android:id="@+id/widget_next" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:padding="12dp" android:src="@drawable/kiji_widget_next" android:contentDescription="@string/kiji_widget_next" />
    </LinearLayout>
</FrameLayout>
