<?xml version="1.0" encoding="utf-8"?>
<!-- Kiji, empieza en 4x2 (portada, canción, onda y controles). Se agranda (4x4, con la letra) o se
     achica (2x2) y se adapta. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp" android:minHeight="110dp" android:targetCellWidth="4" android:targetCellHeight="2"
    android:minResizeWidth="110dp" android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical" android:updatePeriodMillis="0" android:widgetCategory="home_screen"
    android:initialLayout="@layout/kiji_widget_m" android:previewLayout="@layout/kiji_widget_m"
    android:description="@string/kiji_widget_large_description" />
